<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net10.0-windows</TargetFramework>
    <AssemblyName>nape-hud-gui</AssemblyName>
    <RootNamespace>NapeHud</RootNamespace>
    <UseWindowsForms>true</UseWindowsForms>
    <Nullable>enable</Nullable>
    <!-- 画面ごとに拡大率が違っても位置と大きさが崩れないようにする -->
    <ApplicationHighDpiMode>PerMonitorV2</ApplicationHighDpiMode>
    <ImplicitUsings>enable</ImplicitUsings>
    <SelfContained>true</SelfContained>
    <RuntimeIdentifier>win-x64</RuntimeIdentifier>
    <!-- 単一ファイルにはしない。macOS 上でのバンドル生成が
         WinForms のファイル集合で失敗するため、フォルダ配布にする。 -->
    <PublishSingleFile>false</PublishSingleFile>
    <DebugType>none</DebugType>
    <!-- P/Invoke は Windows 専用。macOS でのビルド時に警告を出させない -->
    <NoWarn>CA1416</NoWarn>
    <!-- macOS / Linux から Windows 向けにビルドするために必要 -->
    <EnableWindowsTargeting>true</EnableWindowsTargeting>
  </PropertyGroup>

  <ItemGroup>
    <ProjectReference Include="../NapeHudCore/NapeHudCore.csproj" />
  </ItemGroup>

  <!-- 利用者が編集できるよう config.json を実行ファイルの隣に置く。
       見つからない場合は Core に埋め込んだ既定値で動く。 -->
  <ItemGroup>
    <None Include="../../config.example.json" CopyToOutputDirectory="PreserveNewest" Link="config.json" />
  </ItemGroup>

</Project>
